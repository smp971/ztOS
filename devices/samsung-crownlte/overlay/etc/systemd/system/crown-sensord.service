[Unit]
Description=Note9 light and motion sensor service
Requires=crown-sensorhub.service
After=crown-sensorhub.service

[Service]
# Readiness is checked by the main process, so missing sensors do not hold up
# multi-user.target (and consequently the graphical target).
Type=exec
ExecStart=/usr/local/sbin/crown-sensord
Restart=no
TimeoutStartSec=10

[Install]
WantedBy=multi-user.target
