[Unit]
Description=Note9 light and motion sensor service
Requires=crown-sensorhub.service
After=crown-sensorhub.service

[Service]
ExecStartPre=/bin/sh -c 'for i in $(seq 60); do [ "$(cat /sys/class/sec/sensorhub/ready 2>/dev/null)" = 1 ] && exit 0; sleep 1; done; exit 1'
ExecStart=/usr/local/sbin/ztoscsf-sensord
Restart=no
TimeoutStartSec=65

[Install]
WantedBy=multi-user.target
