#!/bin/sh
set -eu
R=/run/crown-android
# A restart must not mistake the previous ONLINE state for a new secure boot.
if grep -q '^ONLINE' /sys/devices/platform/10000.mif_pdata/modem_state; then
    python3 - <<'PY'
import fcntl, os
fd = os.open('/dev/umts_boot0', os.O_RDWR | os.O_NONBLOCK)
try:
    fcntl.ioctl(fd, 0x6f21, 0)  # _IO('o', 0x21): IOCTL_MODEM_RESET
finally:
    os.close(fd)
PY
fi
timeout 45 chroot --groups=1001,2001,3003,9998,1005,1015,1007,1028,2000,1000 "$R" /vendor/bin/cbd -d -tss310 -bm -mm -P platform/11120000.ufs/by-name/RADIO -n /mnt/vendor/efs &
child=$!
trap 'kill "$child" 2>/dev/null || true; wait "$child" 2>/dev/null || true' EXIT
for tick in $(seq 1 40); do
    if grep -q '^ONLINE' /sys/devices/platform/10000.mif_pdata/modem_state; then
        # Allow CP secure boot and its IPC handshake to settle.
        sleep 5
        exit 0
    fi
    kill -0 "$child" 2>/dev/null || break
    sleep 1
done
echo 'Crown modem did not become ONLINE'
exit 1
